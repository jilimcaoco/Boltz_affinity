# Configuration for the boltz2_affinity_loss delta-scan experiment.
# Inherits all paths from the parent fineturning_experiment, overrides only
# what is specific to this scan (adapter storage, loss, adapter names).
#
# Source from within the scan directory:  source config.env

# ── Parent experiment reference ───────────────────────────────────────────────
export PROJECT_ROOT="/home/limcaoco/turbo/limcaoco/Boltz_affinity"
export EXP_DIR="${PROJECT_ROOT}/fineturning_experiment"
export SCAN_DIR="${EXP_DIR}/huber_delta_scan"

# ── Conda / env ───────────────────────────────────────────────────────────────
export CONDA_ENV="boltz_affinity"

# ── Shared data paths (reuse manifests + poses from main experiment) ──────────
export DATA_DIR="${EXP_DIR}/data"
export MANIFEST_DIR="${EXP_DIR}/manifests"
export MSA_DIR="${EXP_DIR}/msa"
export BOLTZ_MSA_CACHE_DIR="${MSA_DIR}"

# LoRA training manifests built by the main pipeline (steps 04a/04b).
export DRD4_LORA_MANIFEST="${MANIFEST_DIR}/lora_manifest_DRD4.csv"
export HT2A_LORA_MANIFEST="${MANIFEST_DIR}/lora_manifest_5HT2A.csv"

# Validation poses + labels produced by the main analysis pipeline (steps 01-02).
# 03_rescore.slurm reads poses from here; 04_evaluate.slurm reads labels from here.
export VAL_POSES_DIR="${EXP_DIR}/analysis/poses"
export VAL_LABELS_DIR="${EXP_DIR}/analysis/labels"

# ── Scan-local outputs ────────────────────────────────────────────────────────
# Keep adapters in a dedicated sub-registry so they never collide with the
# main experiment's BOLTZ_LORA_DIR.
export ADAPTERS_DIR="${SCAN_DIR}/adapters"
export SCORES_DIR="${SCAN_DIR}/scores"
export METRICS_DIR="${SCAN_DIR}/metrics"
export PLOTS_DIR="${SCAN_DIR}/plots"
export LOG_DIR="${SCAN_DIR}/logs"

# Tell the boltz CLI where to look up adapter names.
export BOLTZ_LORA_DIR="${ADAPTERS_DIR}"
export BOLTZ_CACHE="/home/limcaoco/turbo/limcaoco/.boltz"

# ── Delta scan configuration ──────────────────────────────────────────────────
# Values tested (1.0 → 0.0 in steps of 0.25); SLURM array index maps to these.
# SLURM_ARRAY_TASK_ID:  0    1     2     3     4
export SCAN_DELTAS=(1.00 0.75 0.50 0.25 0.00)

# Path to the parametric loss wrapper (used as file:fn spec in --loss).
export SCAN_LOSSES_FILE="${SCAN_DIR}/losses/delta_scan_losses.py"

# ── LoRA training hyperparameters (identical to main experiment) ──────────────
export LORA_RANK=8
export LORA_ALPHA=16
export LORA_EPOCHS=20
export LORA_LR=1e-4
export LORA_BATCH_SIZE=32
export LORA_TARGET_SPEC="heads_pairformer"
export LORA_EARLY_STOPPING_PATIENCE=5
export LORA_EARLY_STOPPING_MIN_DELTA=0.005

# Binder threshold (log10 µM, ≤10 µM = binder).
export LORA_BINDER_THRESHOLD=1.0
export BOLTZ_LORA_BINDER_THRESHOLD="${LORA_BINDER_THRESHOLD}"

# ── Skip-guard flags ──────────────────────────────────────────────────────────
export FORCE_RETRAIN="${FORCE_RETRAIN:-false}"
export FORCE_RESCORE="${FORCE_RESCORE:-false}"
