# Shared configuration for the DRD4 / 5HT2A LoRA fine-tuning experiment.
# Source this file from the wrapper scripts:  source config.env
#
# Edit these paths once and every SLURM script picks them up.

# ── Project root ─────────────────────────────────────────────────────────────
export PROJECT_ROOT="/home/limcaoco/turbo/limcaoco/Boltz_affinity"
export EXP_DIR="${PROJECT_ROOT}/fineturning_experiment"

# ── Conda / env ──────────────────────────────────────────────────────────────
# Name of the conda env that has boltz + chembl_webresource_client installed.
export CONDA_ENV="boltz_affinity"

# ── Outputs ──────────────────────────────────────────────────────────────────
export DATA_DIR="${EXP_DIR}/data"
export MANIFEST_DIR="${EXP_DIR}/manifests"
export ADAPTERS_DIR="${EXP_DIR}/adapters"
export LOG_DIR="${EXP_DIR}/logs"

# Curated ChEMBL CSV (produced by 01_pull_chembl.slurm).
export CHEMBL_CSV="${DATA_DIR}/chembl_D4_5HT2A_curated.csv"

# LoRA training manifests — one per receptor (produced by 04a / 04b).
export DRD4_LORA_MANIFEST="${MANIFEST_DIR}/lora_manifest_DRD4.csv"
export HT2A_LORA_MANIFEST="${MANIFEST_DIR}/lora_manifest_5HT2A.csv"

# ── Receptor structures (set these to your prepared receptor YAMLs) ──────────
# A Boltz YAML per target (used as the `receptor` column in the manifest *and*
# as the protein scaffold when generating per-ligand prediction YAMLs).
export DRD4_RECEPTOR_YAML="${EXP_DIR}/receptors/DRD4.yaml"
export HT2A_RECEPTOR_YAML="${EXP_DIR}/receptors/5HT2A.yaml"

# ── MSA precompute (step 02) ─────────────────────────────────────────────────
# Precomputed .a3m files — one per (target, chain).  Step 02 writes them;
# step 03 embeds the paths into per-ligand Boltz input YAMLs so that
# `boltz predict` never needs to contact the MSA server at inference scale.
export MSA_DIR="${EXP_DIR}/msa"

# Unified MSA cache directory consumed by every Boltz CLI surface that
# uses `boltz.affinity_rescoring.msa_cache.find_msa` (rescore pdb/batch/
# receptor, lora train, prepare_*_manifest, prepare_*_inputs).
# `find_msa` searches this in addition to any `--msa-directory` flag.
export BOLTZ_MSA_CACHE_DIR="${MSA_DIR}"

# ColabFold API endpoint.  Override if you have a private server.
export MSA_HOST_URL="https://api.colabfold.com"

# ── Boltz prediction (step 03) ───────────────────────────────────────────────
# Per-ligand input YAMLs and Boltz prediction outputs.  Filled in by
# 03_predict_poses.slurm — no manual docking required.
export PREDICT_INPUT_DIR="${EXP_DIR}/predict_inputs"
# Scratch: large Boltz output files live here (Great Lakes scratch, auto-purged ~60 days).
# poses/ will contain symlinks pointing into this directory.
export PREDICT_OUTPUT_DIR="/scratch/maom_root/maom/limcaoco/boltz_predict_outputs"

# Flat per-target poses dirs: one `{molecule_chembl_id}.pdb` per ligand.
# Populated by collect_predicted_poses.py at the end of step 02.
export DRD4_POSES_DIR="${EXP_DIR}/poses/DRD4"
export HT2A_POSES_DIR="${EXP_DIR}/poses/5HT2A"

# Prediction sampling knobs (mirror `boltz predict` defaults; tune for cost).
export PREDICT_RECYCLING_STEPS=3
export PREDICT_SAMPLING_STEPS=200
export PREDICT_DIFFUSION_SAMPLES=1
export PREDICT_OUTPUT_FORMAT="pdb"

# ── Boltz cache (avoid home-quota pressure on the login node) ────────────────
export BOLTZ_CACHE="/home/limcaoco/turbo/limcaoco/.boltz"
export BOLTZ_LORA_DIR="${ADAPTERS_DIR}"

# ── LoRA training hyperparameters ────────────────────────────────────────────
# Per-receptor adapter names — each trains and saves independently.
export DRD4_LORA_NAME="drd4_v2_rank_64"
export HT2A_LORA_NAME="5ht2a_v2_rank_64"

# Shared hyperparameters (applied to both adapters).
export LORA_RANK=32
export LORA_ALPHA=64
export LORA_EPOCHS=20
export LORA_LR=1e-4
export LORA_BATCH_SIZE=32           # >=4 recommended for intra-assay pair loss
export LORA_LOSS="boltz2_affinity"   # paper-faithful: intra-assay Huber + BCE on binary head
# To include right-censored measurements ("> X µM"), rebuild manifests with
#   --keep-censored  and switch to the one-sided loss (also includes BCE branch):
# export LORA_LOSS="censored_boltz2_affinity"
export LORA_TARGET_SPEC="heads_pairformer"

# log10(IC50_uM) cutoff used by build_lora_manifest.py to fill the
# `is_binder` column and (matching) by the BCE branch of `boltz2_affinity`.
# Default 1.0 ⇒ ≤10 µM = binder (Boltz-2 paper convention, pIC50 ≥ 5).
export LORA_BINDER_THRESHOLD=1.0
export BOLTZ_LORA_BINDER_THRESHOLD="${LORA_BINDER_THRESHOLD}"

# ── Early stopping ────────────────────────────────────────────────────────────
# Stop training if the mean epoch loss does not improve by at least
# LORA_EARLY_STOPPING_MIN_DELTA for LORA_EARLY_STOPPING_PATIENCE consecutive
# epochs. Based on observed loss curves (DRD4 / 5HT2A runs plateaued after
# ~3 epochs with oscillations of ≈0.02–0.05): patience=5 and min_delta=0.005
# are conservative enough to let genuine slow improvement continue while
# catching stagnation in long (20-epoch) runs.
# Set LORA_EARLY_STOPPING_PATIENCE=0 to disable early stopping.
export LORA_EARLY_STOPPING_PATIENCE=5
export LORA_EARLY_STOPPING_MIN_DELTA=0.005
